{
  "name": "Loan Service - practical exam",

  // Node 24. The lab needs 22.6+ for TypeScript type stripping, which is
  // what lets `node --test` run the .ts files with no build step.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",

  // Nothing to install - that is the point of this lab.
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "readme",
        "git.openRepositoryInParentFolders": "never"
      }
    }
  }
}
